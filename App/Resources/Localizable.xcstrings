          }
        }
      }
    },
    "Open FSNT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть FSNT"
          }
        }
      }
    },
    "No Preferences menu? FSNT is showing its simple interface. Switch it to the advanced one first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет меню «Настройки»? Значит, FSNT открыт в простом интерфейсе. Сначала переключите его на расширенный."
          }
