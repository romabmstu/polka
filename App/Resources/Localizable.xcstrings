{
  "sourceLanguage": "en",
  "strings": {
    "Star on GitHub": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Звезда на GitHub" } } } },
    "A star helps other people find Polka.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Звезда помогает другим людям найти Polka." } } } },
    "Open Player": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Открыть плеер" } } } },
    "Choose a player or start playback.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Выберите плеер или включите музыку." } } } },
    "Could not connect to GitHub. Check your connection and VPN settings, then try again.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось подключиться к GitHub. Проверьте интернет и настройки VPN, затем повторите попытку." } } } },
    "Volume": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Громкость" } } } },
    "Expand folder": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Развернуть папку" } } } },
    "Collapse folder": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Свернуть папку" } } } },
    "Audio output": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Устройство вывода звука" } } } },
    "Audio output unavailable": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Нет устройства вывода" } } } },
    "Could not update audio output": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось обновить устройство вывода звука" } } } },
    "Could not change volume": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось изменить громкость" } } } },
    "Volume unavailable for this device": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Для этого устройства громкость недоступна" } } } },
    "When nothing is playing, Play starts Yandex Music or opens another selected player. The controls otherwise follow the current source.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Если ничего не играет, Play включает Яндекс Музыку или открывает другой выбранный плеер. В остальных случаях кнопки управляют текущим источником." } } } },
    "Play %@": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Включить %@" } } } },
    "Press play to start Yandex Music": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Нажмите Play, чтобы включить Яндекс Музыку" } } } },
    "The selected player could not be found.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Выбранный плеер не найден." } } } },
    "The selected player could not be opened.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось открыть выбранный плеер." } } } },
    "Allow Accessibility access for Polka, then press play again.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Разрешите Polka доступ в разделе «Универсальный доступ», затем снова нажмите Play." } } } },
    "Could not start Yandex Music. Open the player and check that a track is selected.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось включить Яндекс Музыку. Откройте плеер и проверьте, выбран ли трек." } } } },
    "Loading tabs…": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Загрузка вкладок…" } } } },
    "Could not save tabs. Check available disk space and folder permissions, then try again.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось сохранить вкладки. Проверьте свободное место и доступ к папке, затем повторите попытку." } } } },
    "Could not save tabs": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось сохранить вкладки" } } } },
    "Polka is still open so your changes are not lost. Check available disk space and folder permissions, then try again.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Polka остаётся открытой, чтобы изменения не пропали. Проверьте свободное место и доступ к папке, затем повторите попытку." } } } },
    "Could not save tabs, so the update was not installed. Check disk space and permissions, then try again.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Обновление не установлено: не удалось сохранить вкладки. Проверьте свободное место и доступ к папке, затем повторите попытку." } } } },
    "Tabs are not ready. Open the Tabs section to check.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Вкладки ещё недоступны. Откройте раздел «Вкладки», чтобы проверить состояние." } } } },
    "Try Again": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Повторить" } } } },
    "Polka is already open": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Polka уже открыта" } } } },
    "The other copy could not close. Resolve any save error there before opening another copy.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Не удалось закрыть другую копию. Исправьте в ней ошибку сохранения, прежде чем открывать новую." } } } },
    "Drag to reorder": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Перетащите, чтобы изменить порядок" } } } },
    "Drag to an edge to reorder, or to the center to nest": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Перетащите к краю строки для изменения порядка или в центр для вложения" } } } },
    "Add Link": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Добавить ссылку" } } } },
    "Paste Link": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Вставить ссылку" } } } },
    "Paste or type a link": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Вставьте или введите ссылку" } } } },
    "Enter a valid link.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Введите корректную ссылку." } } } },
    "Link already saved": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Ссылка уже сохранена" } } } },
    "Save the open browser tab, add a link or paste links from the clipboard.": { "localizations": { "ru": { "stringUnit": { "state": "translated", "value": "Сохраните открытую вкладку браузера, добавьте ссылку или вставьте ссылки из буфера обмена." } } } },
    "%@ is open but not connected. Turn on connecting at launch and the system proxy or TUN mode in its settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открыт, но не подключён. Включите в его настройках подключение при запуске и системный прокси или режим TUN."
          }
        }
      }
    },
